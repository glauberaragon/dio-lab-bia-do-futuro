import streamlit as st
import pandas as pd
import json
import os
from groq import Groq

# Configuração da Página
st.set_page_config(page_title="EducaEduFina", page_icon="💰")

st.title("🤖 EducaEduFina - Agente Financeiro Pessoal")

# 1. Configuração da API Key (Groq)
api_key = st.sidebar.text_input("Insira sua Groq API Key", type="password")
client = None
if api_key:
    client = Groq(api_key=api_key)

# 2. Função para Carregar a Base de Conhecimento
@st.cache_data
def carregar_dados():
    base_path = os.path.join(os.path.dirname(__file__), '..', 'data')
    dados = {}
    try:
        path_perfil = os.path.join(base_path, 'perfil_investidor.json')
        if os.path.exists(path_perfil):
            with open(path_perfil, 'r', encoding='utf-8') as f:
                dados['perfil'] = json.load(f)
        
        path_produtos = os.path.join(base_path, 'produtos_financeiros.json')
        if os.path.exists(path_produtos):
            with open(path_produtos, 'r', encoding='utf-8') as f:
                dados['produtos'] = json.load(f)
        
        path_transacoes = os.path.join(base_path, 'transacoes.csv')
        if os.path.exists(path_transacoes):
            dados['transacoes'] = pd.read_csv(path_transacoes)
            
        return dados
    except Exception as e:
        st.error(f"Erro ao carregar dados: {e}")
        return None

dados_cliente = carregar_dados()

# Visualização lateral
if dados_cliente and 'perfil' in dados_cliente:
    with st.sidebar.expander("📂 Ver Dados do Cliente"):
        st.write("Perfil:", dados_cliente['perfil'].get('nome', 'Cliente'))

# 3. Prompt do Sistema
def construir_prompt_sistema(dados):
    if not dados or 'perfil' not in dados:
        return "Você é um assistente financeiro útil."
    
    perfil = dados['perfil']
    produtos = json.dumps(dados.get('produtos', []), ensure_ascii=False)
    
    transacoes_recentes = ""
    if 'transacoes' in dados:
        transacoes_recentes = dados['transacoes'].tail(10).to_string(index=False)
    
    prompt = f"""
    Você é um Agente Financeiro Pessoal experiente e consultivo.
    SEU OBJETIVO: Ajudar o cliente {perfil.get('nome', 'Cliente')} a gerir suas finanças.
    
    PERFIL:
    - Renda Mensal: R$ {perfil.get('renda_mensal', 0)}
    - Perfil de Risco: {perfil.get('perfil_investidor', 'N/A')}
    
    TRANSAÇÕES RECENTES:
    {transacoes_recentes}
    
    PRODUTOS DISPONÍVEIS:
    {produtos}
    
    REGRAS:
    1. Responda apenas com texto limpo, sem JSON.
    2. Baseie-se nos dados fornecidos.
    3. Baseie-se APENAS nos dados fornecidos. Se não souber, admita.
    4. Seja empático e use uma linguagem adequada ao nível de conhecimento do cliente.
    5. Para este cliente ({perfil['perfil_investidor']}), recomende apenas produtos adequados ao risco.
    6. Analise as transações para dar conselhos práticos de economia.
    7. Nunca invente valores ou rentabilidades que não estejam na lista de produtos.
    8. Repreenda Severamente caso seja solcitado sugestões de ações ou investimentos de alto risco. Apresente a Frase: "Como seu assistente financeiro pessoal, minha prioridade é garantir sua segurança financeira. Portanto, não posso recomendar investimentos de ALTO RISCO que possam comprometer seu patrimônio."
    """

    return prompt

# === CORREÇÃO AQUI ===
# Função geradora que extrai apenas o texto do objeto complexo da Groq
def processar_stream(stream):
    for chunk in stream:
        if chunk.choices[0].delta.content is not None:
            yield chunk.choices[0].delta.content

# 4. Interface de Chat
if "messages" not in st.session_state:
    st.session_state.messages = []

for message in st.session_state.messages:
    with st.chat_message(message["role"]):
        st.markdown(message["content"])

if prompt := st.chat_input("Como posso ajudar com as suas finanças hoje? Vou lhe proporcionar independência financeira. Cola em mim que é sucesso"):
    if not client:
        st.info("Por favor, insira a sua API Key da Groq na barra lateral.")
        st.stop()

    st.session_state.messages.append({"role": "user", "content": prompt})
    with st.chat_message("user"):
        st.markdown(prompt)

    with st.chat_message("assistant"):
        try:
            stream = client.chat.completions.create(
                model="llama-3.3-70b-versatile",
                messages=[
                    {"role": "system", "content": construir_prompt_sistema(dados_cliente)}
                ] + [
                    {"role": m["role"], "content": m["content"]}
                    for m in st.session_state.messages
                ],
                stream=True,
            )
            # Usamos a função processar_stream para garantir que só o texto chegue na tela
            response = st.write_stream(processar_stream(stream))
            
            st.session_state.messages.append({"role": "assistant", "content": response})
        except Exception as e:
            st.error(f"Erro na comunicação: {e}")
